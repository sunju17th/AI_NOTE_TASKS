# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCKER COMPOSE CHO DỰ ÁN NOTE_TASK_AI
# Sao chép file này thành .env ở thư mục gốc trước khi chạy docker compose:
# cp .env.example .env
# ==============================================================================

# 1. Cấu hình Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=AI_TASK_NOTE
POSTGRES_PORT=5432

# 2. Cấu hình Backend API
BACKEND_PORT=3000
JWT_SECRET=super_secret_jwt_key_for_docker_note_task_ai_2026
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGIN=*

# 3. Cấu hình Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
