                  "        method: 'GET',",
                  "        header: { 'Authorization': 'Bearer ' + token }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            const list = res.json();",
                  "            if (Array.isArray(list) && list.length > 0) {",
                  "                pm.collectionVariables.set('categoryId', list[0].id);",
                  "                console.log('✅ Đã gán categoryId hợp lệ:', list[0].id);",
                  "            } else {",
                  "                // Nếu user chưa có danh mục nào -> Tự tạo ngay 1 danh mục!",
                  "                pm.sendRequest({",
                  "                    url: baseUrl + '/categories',",
                  "                    method: 'POST',",
                  "                    header: {",
                  "                        'Content-Type': 'application/json',",
                  "                        'Authorization': 'Bearer ' + token",
                  "                    },",
                  "                    body: {",
                  "                        mode: 'raw',",
                  "                        raw: JSON.stringify({",
                  "                            name: 'Lập trình Backend',",
                  "                            description: 'Tài liệu học Backend'",
                  "                        })",
                  "                    }",
                  "                }, function (cErr, cRes) {",
                  "                    if (!cErr && cRes.code === 201) {",
                  "                        pm.collectionVariables.set('categoryId', cRes.json().id);",
                  "                        console.log('✅ Đã tự tạo category mới:', cRes.json().id);",
                  "                    }",
                  "                });",
                  "            }",
                  "        }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
