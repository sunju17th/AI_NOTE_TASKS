# Cổng lắng nghe của Backend Server
PORT=3000

# Chuỗi kết nối PostgreSQL (Chạy local hoặc qua Docker)
# Local: postgresql://postgres:password@localhost:5432/AI_TASK_NOTE
# Docker: postgresql://postgres:postgres@postgres:5432/AI_TASK_NOTE
DATABASE_URL=postgresql://postgres:password@localhost:5432/AI_TASK_NOTE

# Mã bí mật JWT dùng để ký và xác thực token (Thay bằng chuỗi bảo mật ngẫu nhiên)
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Khóa API Google Gemini AI (Lấy tại Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini mặc định (Mặc định: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Cấu hình CORS (Cho phép Frontend gọi API)
CORS_ORIGIN=http://localhost:5173
